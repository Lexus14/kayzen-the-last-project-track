# Salin file ini ke ~/.kltp-sender.env di Termux, lalu isi nilainya.
# JANGAN commit file ~/.kltp-sender.env dan JANGAN bagikan token perangkat.
SERVER_URL=http://127.0.0.1:8000
# Untuk akses lewat Cloudflare Tunnel, ganti dengan URL tunnel (tanpa membagikannya):
# SERVER_URL=https://namatunnel-kamu.trycloudflare.com
DEVICE_ID=1
DEVICE_TOKEN=token-perangkat-kamu
INTERVAL_SECONDS=30
# QUEUE_PATH=~/.cache/kltp_sender_queue.jsonl
